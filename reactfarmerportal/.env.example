VITE_API_URL=http://localhost:4000

# Google Maps for the farm-pin step (Maps JavaScript API; enable Geocoding API for place search).
# Restrict the key to your site's domain in Google Cloud Console. Without it the app uses the drawn canal map.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (needed for the pins). DEMO_MAP_ID works for testing.
VITE_GOOGLE_MAPS_MAP_ID=

# Farmer auth API (/api/auth/*). In dev, Vite proxies /api/auth to this target so the
# refresh-token cookie (httpOnly, SameSite=Strict) stays same-origin. Default: http://127.0.0.1:8005
AUTH_PROXY_TARGET=http://127.0.0.1:8005
# Leave empty to use the proxy. Only set it if the API is served from the same site as the portal.
VITE_AUTH_URL=
